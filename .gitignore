# 网站子项目忽略规则（独立仓库 gooddaysboy/deskbud）
.DS_Store
*.log
Thumbs.db

# 开发手册（内部笔记，不发布）
开发手册.md

# 临时/中间产物（可重生）
_tmp/
.tmp_rbt/

# 回收站（本机"删除拦截"规避：删类操作先 mv 到这里，不入库）
_trash/

# 素材预览是生成物（gen_preview 类脚本产出，不入库）
scripts/素材预览_*.html

# WorkBuddy 项目记忆与运行数据（不发布）
.workbuddy/
__pycache__/

# 自检截图产物（outputs/，本地视觉自检用，不入库）
outputs/
