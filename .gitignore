# 网站子项目忽略规则（独立仓库 gooddaysboy/deskbud）
.DS_Store
*.log
Thumbs.db

# 开发手册（内部笔记，不发布）
开发手册.md
SPEC.md

# 🔴 内部设计/实现文档（2026-07 老曹定：public 仓库不泄露设计与素材产线）
#   版式基准（含精确坐标/配色/生成器路径）· 防刷规则 —— 线上被 curl 直接下载 = 泄设计
assets/share/share-card-spec.md
docs/referer-guard.md

# 🔴 生产脚本不入库（2026-07）：仓库是 public，scripts/ 全量可 git clone 拿走。
#   含素材产线（gen_*/apply_*）、一次性修补（fix_*）、离线校验（verify/）——
#   实现价值高于产品本身。**本机文件全部保留**，仅从版本控制移出。
#   ⚠️ 代价：换机/新会话需从本机或备份取；协板/记忆里已记录位置。
scripts/

# 临时/中间产物（可重生）
_tmp/
.tmp_rbt/

# 回收站（本机"删除拦截"规避：删类操作先 mv 到这里，不入库）
_trash/

# 本地备份专用（在线数据文件的旧版/快照，仅本机回滚用，绝不部署、绝不入库）
_local_backup/

# 素材预览是生成物（gen_preview 类脚本产出，不入库）
scripts/素材预览_*.html

# WorkBuddy 项目记忆与运行数据（不发布）
.workbuddy/
__pycache__/

# 自检截图产物（outputs/，本地视觉自检用，不入库）
outputs/
