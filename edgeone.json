{
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/*",
      "headers": [
        {
          "key": "Alt-Svc",
          "value": "h3=\":443\"; ma=86400"
        }
      ]
    }
  ]
}
